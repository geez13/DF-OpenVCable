# ============================================================
# DF-OpenVCable — .gitignore
# ============================================================
# Prinsip: repository menyimpan SOURCE, bukan artefak build.
# Paket rilis resmi tersedia di GitHub Releases (tag: latest-build),
# dihasilkan oleh .github/workflows/build.yml.

# ---- Paket rilis lokal (AIR/) ----
# AIR/ adalah folder EKSTRAKSI artefak rilis (hasil unduhan dari Releases),
# bukan sumber. Seluruh isinya diabaikan supaya tidak ada dua sumber kebenaran:
# sumber sebenarnya ada di package/, control_panel/, tests/, dan docs/.
AIR/

# Arsip rilis yang terunduh ke root repo
/DF-OpenVCable-v*.zip

# ---- Output build WDK (package/) ----
package/*.sys
package/*.cat
package/*.cer
package/*.zip
package/x64/
package/ARM64/
package/Release/
package/Debug/
package/*.inf.bak

# ---- Objek & simbol kompilasi ----
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.res
*.tmp
*.log
*.wrn
*.err
*.etl
*.dmp

# ---- Visual Studio / MSBuild ----
.vs/
*.user
*.suo
*.vcxproj.filters
*.vcxproj.user
ipch/
x64/
ARM64/
Debug/
Release/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- Output build macOS (macos/) ----
macos/build/

# ---- OS & editor ----
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
